# ─────────────────────────────────────────
# Anti Gravity Server — Environment Variables
# Copy to .env and fill in real values
# NEVER commit .env to git
# ─────────────────────────────────────────

NODE_ENV=development
PORT=5000

# ─── Database (Supabase) ─────────────────
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Direct Postgres URL (for migrations and complex queries via pg driver)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# ─── Redis (Upstash or Railway Redis) ────
REDIS_URL=redis://default:YOUR_PASSWORD@YOUR_REDIS_HOST:6379

# ─── JWT ─────────────────────────────────
# Must be at least 32 characters — generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=your_access_token_secret_min_32_chars
JWT_REFRESH_SECRET=your_refresh_token_secret_min_32_chars_different_from_access

# Token TTLs
JWT_ACCESS_EXPIRES_IN=15m       # Access token: 15 minutes
JWT_REFRESH_EXPIRES_IN=7d       # Refresh token: 7 days
JWT_REFRESH_EXPIRES_SECONDS=604800  # 7 days in seconds (for Redis TTL)

# ─── OTP (MSG91) ─────────────────────────
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_SENDER_ID=ANTGRV
MSG91_TEMPLATE_ID=your_msg91_template_id
OTP_TTL_SECONDS=600            # 10 minutes

# ─── Cloudinary ──────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── FCM (Firebase Cloud Messaging) ──────
FCM_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# ─── Security ────────────────────────────
BCRYPT_ROUNDS=10
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_DURATION_MINUTES=30
RATE_LIMIT_WINDOW_MS=900000    # 15 minutes
RATE_LIMIT_MAX_REQUESTS=10     # per window per IP

# ─── CORS ────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,https://antigravity.vercel.app

# ─── Logging ─────────────────────────────
LOG_LEVEL=debug                # debug | info | warn | error
